root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.plist]
indent_style = tab

[Makefile]
indent_style = tab

# Written by Xcode and `make strings` (xcstringstool) without a final newline.
[*.xcstrings]
insert_final_newline = false
