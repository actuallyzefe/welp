          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir mesaj yaz"
          }
        }
      }
    },
    "Undo" : {
      "comment" : "Edit menu item.\nProtection mode name: no prompt, the message is held with an Undo notice.\nShort protection mode name, in a compact picker.\nUndo toast button; stops the held message.",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geri al"
          }
        }
      }
