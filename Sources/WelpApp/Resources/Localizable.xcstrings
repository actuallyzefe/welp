{
  "sourceLanguage" : "en",
  "strings" : {
    "%@: couldn’t tell which chat this message will go to." : {
      "comment" : "Confirmation prompt when the chat is unknown. The argument is WhatsApp or Slack.",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: mesajın hangi sohbete gideceği algılanamadı."
          }
        }
      }
    },
    "%@: open a chat to protect it" : {
      "comment" : "Menu bar menu. The argument is WhatsApp or Slack.",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: korumak için bir sohbet aç"
          }
        }
      }
    },
    "%lld chats" : {
      "comment" : "Settings sidebar: number of guarded chats.",
